[Unit]
Description=AetherRemote fixed-purpose signed release updater
After=local-fs.target
Before=aetherremote-station-engine.service aetherremote-agent.service

[Service]
Type=simple
User=root
Group=aetherremote
WorkingDirectory=/opt/aetherremote/updater
ExecStart=/opt/aetherremote/updater/AetherRemote.Updater
Restart=on-failure
RestartSec=3
RuntimeDirectory=aetherremote-release-updater
RuntimeDirectoryMode=0770
TimeoutStopSec=15

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/opt/aetherremote /var/lib/aetherremote /etc/systemd/system
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
# The self-contained .NET updater JIT requires executable memory mappings.
# Retain the remaining root-service sandbox while avoiding a startup crash.
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
