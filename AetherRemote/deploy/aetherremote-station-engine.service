[Unit]
Description=AetherRemote station-local receive engine
After=network-online.target
Wants=network-online.target
Before=aetherremote-agent.service

[Service]
Type=simple
User=aetherremote
Group=aetherremote
WorkingDirectory=/opt/aetherremote/station-engine
Environment=ASPNETCORE_ENVIRONMENT=Development
Environment=DOTNET_ENVIRONMENT=Development
Environment=ASPNETCORE_URLS=http://127.0.0.1:5081
Environment=ASPNETCORE_CONTENTROOT=/etc/aetherremote/station-engine
Environment=InstallationServiceHost__Role=StationEngine
ExecStart=/opt/aetherremote/station-engine/AetherSDR.Web
Restart=on-failure
RestartSec=3
TimeoutStartSec=30
TimeoutStopSec=15

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/aetherremote/station-engine
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=multi-user.target
