[Unit]
Description=AetherSDR receive-only web gateway (user service)
ConditionUser=flexweb
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/home/flexweb/aethersdr/current
EnvironmentFile=/home/flexweb/.config/aethersdr-web/environment
ExecStart=/home/flexweb/aethersdr/current/AetherSDR.Web --urls http://0.0.0.0:5080
Restart=on-failure
RestartSec=3
TimeoutStartSec=30
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aethersdr-web
LogRateLimitIntervalSec=30
LogRateLimitBurst=2000
NoNewPrivileges=true
PrivateUsers=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
StateDirectory=aethersdr-web
StateDirectoryMode=0700
InaccessiblePaths=-/home/flexweb/.ssh
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077

[Install]
WantedBy=default.target
