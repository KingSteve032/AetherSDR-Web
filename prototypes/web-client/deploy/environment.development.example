# Replace Development authentication with OIDC before production use.
ASPNETCORE_ENVIRONMENT=Development
InstallationSetupOnly__Enabled=false
InstallationSetupOnly__CanonicalAccessUrl=
InstallationRuntime__Enabled=false
Auth__Mode=Development
AllowedHosts='10.2.0.254;localhost;127.0.0.1'
ReverseProxy__Enabled=true
ReverseProxy__KnownProxies__0=10.2.0.162
Radio__Mode=FlexRx
