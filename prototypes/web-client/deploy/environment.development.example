Radio__AllowTransmit=false
Radio__BrowserTxLeaseEnabled=false
StationTxProductionActivation__Enabled=false
ReleaseManifestTrust__VerificationEnabled=false
ReleaseMigrationRunnerTrust__SelectionEnabled=false
ReleaseActivationServiceControl__ExecutionEnabled=false
ReleaseActivationHealthVerification__ExecutionEnabled=false
StationTxCommandTrust__VerificationEnabled=false
StationTxCommandSigning__SigningEnabled=false
StationTxCommandEnvelopeCoordinator__SubmissionEnabled=false
