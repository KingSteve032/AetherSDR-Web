# Temporary receive-only pilot profile for deploy/user/aethersdr-web.service
# on a trusted LAN/VPN. Do not use these home-state paths with the system unit.
# Replace Development authentication with OIDC before production use.
ASPNETCORE_ENVIRONMENT=Development
InstallationSetupOnly__Enabled=false
InstallationSetupOnly__CanonicalAccessUrl=
InstallationRuntime__Enabled=false
Auth__Mode=Development
AllowedHosts='10.2.0.254;localhost;127.0.0.1'
ReverseProxy__Enabled=true
ReverseProxy__KnownProxies__0=10.2.0.162
Radio__Mode=FlexRx
Radio__Host=10.2.0.12
Radio__TcpPort=4992
Radio__AllowTransmit=false
Radio__BrowserTxLeaseEnabled=false
StationTxProductionActivation__Enabled=false
ReleaseManifestTrust__VerificationEnabled=false
ReleaseGitHubSource__Enabled=false
ReleaseGitHubSource__Owner=KingSteve032
ReleaseGitHubSource__Repository=AetherSDR-Web
ReleaseGitHubSource__MaximumReleaseCount=32
ReleaseGitHubSource__RequestTimeoutSeconds=30
ReleaseMigrationRunnerTrust__SelectionEnabled=false
ReleaseActivationServiceControl__ExecutionEnabled=false
ReleaseActivationServiceControl__RemoteExecutionEnabled=false
ReleaseActivationServiceControl__RemoteStationId=
ReleaseActivationCurrentPointerSwitch__ExecutionEnabled=false
ReleaseActivationHealthVerification__ExecutionEnabled=false
ReleaseActivationRollback__ExecutionEnabled=false
ReleaseActivationRollback__ExpectedStationId=
ReleaseActivationOperatorApproval__AuthorityEnabled=false
ReleaseActivationOperatorApproval__MaximumApprovalAgeSeconds=300
ReleaseUpdateTransaction__ExecutionEnabled=false
ReleaseUpdateTransaction__LeaseDrainSeconds=30
ReleaseActivationHostRestart__ExecutionEnabled=false
StationTxCommandTrust__VerificationEnabled=false
StationTxCommandSigning__SigningEnabled=false
StationTxCommandEnvelopeCoordinator__SubmissionEnabled=false
Radio__StationName=AETHER-WEB-RX
DataProtection__KeyPath=/home/flexweb/.local/state/aethersdr-web/keys
RadioAccess__PolicyPath=/home/flexweb/.local/state/aethersdr-web/radio-access.json
RadioAccess__AuditPath=/home/flexweb/.local/state/aethersdr-web/audit.json
