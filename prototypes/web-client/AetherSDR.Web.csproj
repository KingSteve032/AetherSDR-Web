<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AetherSDR.Web</RootNamespace>
    <AssemblyName>AetherSDR.Web</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup Condition="'$(EnableTxHil)' == 'true'">
    <DefineConstants>$(DefineConstants);AETHERSDR_TX_HIL</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect"
                      Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\tx-watchdog\AetherSDR.TxWatchdog.Protocol\AetherSDR.TxWatchdog.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\assets\logo-circle-256.png"
             Link="wwwroot\assets\logo.png"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\assets\meterfaces\s-meter-v1.json"
             Link="wwwroot\assets\s-meter-v1.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\assets\bandplans\arrl-us.json"
             Link="wwwroot\assets\bandplans\arrl-us.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="deploy\validate-production-tx-activation.sh"
             Link="tools\validate-production-tx-activation.sh"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="deploy\validate-setup-only-host.sh"
             Link="tools\validate-setup-only-host.sh"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="deploy\SETUP-ONLY-ACCEPTANCE.md"
             Link="tools\SETUP-ONLY-ACCEPTANCE.md"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="deploy\aethersdr-release-updater.service"
             Link="tools\aethersdr-release-updater.service"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="deploy\installer\systemd\*.service"
             Link="installer\systemd\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="deploy\installer\proxy\*"
             Link="installer\proxy\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <Content Remove="tests\**\*" />
    <EmbeddedResource Remove="tests\**\*" />
    <None Remove="tests\**\*" />
    <Compile Remove="tx-hil\**\*.cs" />
    <Content Remove="tx-hil\**\*" />
    <EmbeddedResource Remove="tx-hil\**\*" />
    <None Remove="tx-hil\**\*" />
    <Compile Remove="tx-hil-tests\**\*.cs" />
    <Content Remove="tx-hil-tests\**\*" />
    <EmbeddedResource Remove="tx-hil-tests\**\*" />
    <None Remove="tx-hil-tests\**\*" />
  </ItemGroup>
</Project>
